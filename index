                  </div>
                </label>
                <label class="cursor-pointer">
                  <input type="radio" name="attending" value="No" onchange="toggleSeatFields(false)" class="peer sr-only" />
                  <div class="p-3 rounded-xl border border-sage-200 text-center text-sm font-medium text-sage-700 peer-checked:bg-rosegold-500 peer-checked:text-white peer-checked:border-rosegold-500 transition-all">
                    Regretfully Declines
                  </div>
                </label>
              </div>
            </div>

            <!-- Number of Reserved Seats -->
            <div id="seatReservationWrapper" class="space-y-4 transition-all">
              <div>
                <label for="seatCount" class="block text-xs uppercase tracking-wider font-semibold text-sage-700 mb-1.5">
                  Number of Seats Reserved *
                </label>
                <select
                  id="seatCount"
                  onchange="renderAdditionalGuests()"
                  class="w-full px-4 py-3 rounded-xl border border-sage-200 text-sm focus:outline-none focus:border-rosegold-400 bg-champagne/40 font-medium text-sage-800"
                >
                  <option value="1">1 Seat (Solo Guest)</option>
                  <option value="2" selected>2 Seats (Couple / +1 Guest)</option>
                  <option value="3">3 Seats (Family / Group)</option>
                  <option value="4">4 Seats (Family / Group)</option>
                  <option value="5">5 Seats (Full Family Table)</option>
                </select>
              </div>

              <!-- Dynamic Additional Guest Names -->
              <div id="additionalGuestsContainer" class="space-y-2.5"></div>
            </div>

            <div>
              <label for="guestMessage" class="block text-xs uppercase tracking-wider font-semibold text-sage-700 mb-1.5">
                Message for Kaye &amp; Val (or Dietary Notes)
              </label>
              <textarea
                id="guestMessage"
                rows="3"
                placeholder="Write your wishes for the couple..."
                class="w-full px-4 py-3 rounded-xl border border-sage-200 text-sm focus:outline-none focus:border-rosegold-400 bg-champagne/40"
              ></textarea>
            </div>

            <button
              type="submit"
              class="w-full py-3.5 px-6 rounded-xl rosegold-gradient text-white text-xs font-semibold uppercase tracking-[0.2em] shadow-rosegold hover:opacity-95 transition-all"
            >
              Confirm Seat Reservation
            </button>
