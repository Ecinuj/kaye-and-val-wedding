<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Kaye & Val — December 09, 2026 | Wedding Invitation</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&family=Pinyon+Script&family=Plus+Jakarta+Sans:wght@300;400;500;600&display=swap"
    rel="stylesheet"
  />
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            sage: {
              50: '#F5F7F4',
              100: '#E8EDE6',
              200: '#D2DDD0',
              300: '#B2C4B0',
              400: '#8FA693',
              500: '#6C8771',
              600: '#4A5D4E',
              700: '#39483C',
              800: '#2A352C',
            },
            rosegold: {
              50: '#FDF8F7',
              100: '#F8ECEA',
              200: '#F0D5D1',
              300: '#E2B4AE',
              400: '#CE8E87',
              500: '#B76E79',
              600: '#9E5863',
              700: '#7E444E',
            },
            champagne: '#FAF7F5',
            charcoal: '#2C332E',
          },
          fontFamily: {
            script: ['"Pinyon Script"', 'cursive'],
            serif: ['"Cormorant Garamond"', 'Georgia', 'serif'],
            sans: ['"Plus Jakarta Sans"', 'sans-serif'],
          },
          boxShadow: {
            'soft': '0 10px 40px -10px rgba(74, 93, 78, 0.12)',
            'rosegold': '0 10px 30px -8px rgba(183, 110, 121, 0.25)',
          }
        },
      },
    };
  </script>
  <style>
    body {
      background-color: #FAF7F5;
      color: #2C332E;
      font-family: 'Plus Jakarta Sans', sans-serif;
      overflow-x: hidden;
    }

    .rosegold-gradient {
      background: linear-gradient(135deg, #D9A29C 0%, #B76E79 50%, #9E5863 100%);
    }

    .rosegold-text-gradient {
      background: linear-gradient(135deg, #C9857E 0%, #B76E79 55%, #8D4954 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .rosegold-border {
      border: 1px solid rgba(183, 110, 121, 0.35);
    }

    .sage-glass {
      background: rgba(255, 255, 255, 0.85);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border: 1px solid rgba(183, 110, 121, 0.22);
    }

    /* Wax Seal Styling inspired by the video opening */
    .wax-seal {
      background: radial-gradient(circle at 30% 30%, #D47A84, #B76E79 60%, #8C4752 100%);
      box-shadow:
        0 8px 20px rgba(140, 71, 82, 0.35),
        inset 0 2px 5px rgba(255, 255, 255, 0.4),
        inset 0 -3px 6px rgba(80, 30, 38, 0.45);
    }

    /* Subtle fade-up animation */
    .reveal {
      opacity: 0;
      transform: translateY(22px);
      transition: all 0.8s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .reveal.visible {
      opacity: 1;
      transform: translateY(0);
    }

    /* Custom Scrollbar */
    ::-webkit-scrollbar {
      width: 8px;
    }
    ::-webkit-scrollbar-track {
      background: #F5F7F4;
    }
    ::-webkit-scrollbar-thumb {
      background: #B2C4B0;
      border-radius: 9999px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #B76E79;
    }
  </style>
</head>
<body class="antialiased selection:bg-rosegold-200 selection:text-sage-800">

  <!-- Decorative Top Botanical Corner SVGs -->
  <div class="fixed top-0 left-0 w-40 sm:w-64 pointer-events-none z-0 opacity-35">
    <svg viewBox="0 0 200 200" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M-10 10 C40 30, 80 70, 95 140" stroke="#6C8771" stroke-width="1.5" stroke-linecap="round"/>
      <path d="M25 32 C55 25, 78 40, 82 58 C60 62, 38 50, 25 32 Z" fill="#8FA693" fill-opacity="0.5"/>
      <path d="M52 60 C82 54, 105 70, 108 90 C84 93, 62 80, 52 60 Z" fill="#6C8771" fill-opacity="0.45"/>
      <path d="M18 68 C42 82, 48 108, 36 125 C18 112, 10 88, 18 68 Z" fill="#B2C4B0" fill-opacity="0.6"/>
      <circle cx="88" cy="42" r="5" fill="#CE8E87" fill-opacity="0.6"/>
      <circle cx="112" cy="78" r="4" fill="#B76E79" fill-opacity="0.5"/>
    </svg>
  </div>
  <div class="fixed bottom-0 right-0 w-40 sm:w-64 pointer-events-none z-0 opacity-35 rotate-180">
    <svg viewBox="0 0 200 200" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M-10 10 C40 30, 80 70, 95 140" stroke="#6C8771" stroke-width="1.5" stroke-linecap="round"/>
      <path d="M25 32 C55 25, 78 40, 82 58 C60 62, 38 50, 25 32 Z" fill="#8FA693" fill-opacity="0.5"/>
      <path d="M52 60 C82 54, 105 70, 108 90 C84 93, 62 80, 52 60 Z" fill="#6C8771" fill-opacity="0.45"/>
      <path d="M18 68 C42 82, 48 108, 36 125 C18 112, 10 88, 18 68 Z" fill="#B2C4B0" fill-opacity="0.6"/>
