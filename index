      <circle cx="112" cy="78" r="4" fill="#B76E79" fill-opacity="0.5"/>
    </svg>
  </div>

  <!-- Sticky Navigation Bar -->
  <header class="sticky top-0 z-40 sage-glass border-b border-rosegold-200/60 transition-all">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
      <a href="#home" class="flex items-center gap-2.5 group">
        <span class="w-9 h-9 rounded-full wax-seal flex items-center justify-center text-white font-serif text-sm font-semibold tracking-wider">
          K&V
        </span>
        <span class="font-serif text-xl font-semibold text-sage-700 tracking-wide group-hover:text-rosegold-500 transition-colors">
          Kaye <span class="font-script text-2xl text-rosegold-500">&amp;</span> Val
        </span>
      </a>

      <!-- Desktop Nav Links -->
      <nav class="hidden md:flex items-center gap-6 text-xs uppercase tracking-[0.16em] font-medium text-sage-700">
        <a href="#video-invite" class="hover:text-rosegold-500 transition-colors">Invitation</a>
        <a href="#details" class="hover:text-rosegold-500 transition-colors">Details</a>
        <a href="#entourage" class="hover:text-rosegold-500 transition-colors">Entourage</a>
        <a href="#attire" class="hover:text-rosegold-500 transition-colors">Attire</a>
        <a href="#rsvp" class="hover:text-rosegold-500 transition-colors">RSVP</a>
        <a href="#gifts" class="hover:text-rosegold-500 transition-colors">Gifts</a>
      </nav>

      <!-- Action Buttons -->
      <div class="flex items-center gap-2">
        <button
          onclick="toggleCanvaModal(true)"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-medium bg-sage-100 text-sage-700 hover:bg-sage-200 border border-sage-300/70 transition-all"
          title="View Canva Color Codes, Fonts & Embedding Guide"
        >
          <svg class="w-3.5 h-3.5 text-rosegold-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
          </svg>
          <span class="hidden sm:inline">Edit in Canva</span>
          <span class="sm:hidden">Canva</span>
        </button>
        <a
          href="#rsvp"
          class="px-4 py-1.5 rounded-full text-xs font-semibold uppercase tracking-wider text-white rosegold-gradient shadow-rosegold hover:opacity-95 transition-all"
        >
          RSVP
        </a>
      </div>
    </div>
  </header>

  <!-- 1. HERO SECTION -->
  <section id="home" class="relative pt-12 pb-20 sm:pt-20 sm:pb-28 px-4 sm:px-6 overflow-hidden">
    <div class="max-w-4xl mx-auto text-center relative z-10">
      <!-- Wax Seal Emblem -->
      <div class="mx-auto mb-6 w-20 h-24 rounded-full wax-seal flex flex-col items-center justify-center text-white border-2 border-rosegold-200/40 shadow-lg">
        <!-- Rose Outline SVG -->
        <svg class="w-10 h-10 text-rosegold-100" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 3c2.5 0 4.5 1.8 4.5 4.2 0 2.1-1.5 3.8-3.5 4.2m-1-8.4C9.5 3 7.5 4.8 7.5 7.2c0 2.1 1.5 3.8 3.5 4.2m1-8.4c1.2 1.2 1.2 3.2 0 4.4-1.2-1.2-1.2-3.2 0-4.4zm0 8.4V21m0-5c-2.5 0-4.5-1.5-5-3.5m5 5.5c2.5 0 4.5-1.5 5-3.5"/>
        </svg>
        <span class="text-[10px] tracking-[0.22em] uppercase font-serif mt-0.5 text-rosegold-100">12•09•26</span>
      </div>

      <p class="font-script text-3xl sm:text-4xl text-sage-600 mb-2">
        We are getting married...
      </p>

      <h1 class="font-serif text-5xl sm:text-7xl md:text-8xl font-semibold text-sage-700 tracking-tight leading-none my-3">
        Kaye <span class="font-script text-6xl sm:text-8xl md:text-9xl rosegold-text-gradient font-normal px-1">&amp;</span> Val
      </h1>

      <div class="flex items-center justify-center gap-3 my-6">
        <span class="h-px w-12 sm:w-20 bg-rosegold-300"></span>
        <span class="text-xs uppercase tracking-[0.28em] text-rosegold-600 font-semibold">Save The Date</span>
        <span class="h-px w-12 sm:w-20 bg-rosegold-300"></span>
      </div>

      <!-- Full Names -->
      <div class="space-y-1.5 mb-8">
        <p class="font-serif text-xl sm:text-2xl font-semibold tracking-wide text-sage-800 uppercase">
          Emily Claire B. Baranuelo
        </p>
        <p class="font-script text-2xl text-rosegold-500">and</p>
        <p class="font-serif text-xl sm:text-2xl font-semibold tracking-wide text-sage-800 uppercase">
          Val Celso P. Cunanan Jr.
        </p>
      </div>

      <p class="max-w-xl mx-auto text-sm sm:text-base text-sage-600 italic font-serif text-lg mb-8">
        "Together with their families, request the honor of your presence as they exchange vows of love and commitment."
      </p>

      <!-- Date & Location Pill -->
      <div class="inline-flex flex-col sm:flex-row items-center gap-3 sm:gap-6 px-6 py-4 rounded-2xl sage-glass shadow-soft mb-10">
        <div class="text-center sm:text-right">
          <p class="text-xs uppercase tracking-[0.2em] text-rosegold-500 font-semibold">Wednesday</p>
          <p class="font-serif text-2xl font-bold text-sage-700">December 09, 2026</p>
        </div>
        <div class="hidden sm:block h-10 w-px bg-rosegold-200"></div>
        <div class="text-center sm:text-left">
          <p class="text-xs uppercase tracking-[0.2em] text-rosegold-500 font-semibold">At 2:00 PM</p>
          <p class="font-serif text-lg font-medium text-sage-700">Naga City, Camarines Sur</p>
        </div>
      </div>

      <!-- Live Countdown Timer -->
      <div class="max-w-lg mx-auto">
        <p class="text-[11px] uppercase tracking-[0.25em] text-sage-500 mb-3 font-medium">Counting down to forever</p>
        <div id="countdown" class="grid grid-cols-4 gap-2.5 sm:gap-4">
          <div class="rounded-2xl bg-white/90 rosegold-border p-3 sm:p-4 shadow-sm">
            <span id="cd-days" class="block font-serif text-2xl sm:text-4xl font-bold text-sage-700">00</span>
            <span class="text-[10px] sm:text-xs uppercase tracking-widest text-rosegold-500 font-medium">Days</span>
          </div>
          <div class="rounded-2xl bg-white/90 rosegold-border p-3 sm:p-4 shadow-sm">
            <span id="cd-hours" class="block font-serif text-2xl sm:text-4xl font-bold text-sage-700">00</span>
            <span class="text-[10px] sm:text-xs uppercase tracking-widest text-rosegold-500 font-medium">Hours</span>
          </div>
          <div class="rounded-2xl bg-white/90 rosegold-border p-3 sm:p-4 shadow-sm">
            <span id="cd-mins" class="block font-serif text-2xl sm:text-4xl font-bold text-sage-700">00</span>
            <span class="text-[10px] sm:text-xs uppercase tracking-widest text-rosegold-500 font-medium">Mins</span>
          </div>
          <div class="rounded-2xl bg-white/90 rosegold-border p-3 sm:p-4 shadow-sm">
            <span id="cd-secs" class="block font-serif text-2xl sm:text-4xl font-bold text-rosegold-500">00</span>
            <span class="text-[10px] sm:text-xs uppercase tracking-widest text-sage-600 font-medium">Secs</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. ATTACHED VIDEO INVITATION SECTION -->
  <section id="video-invite" class="py-16 sm:py-24 px-4 sm:px-6 bg-sage-50/90 border-y border-sage-200/70 reveal">
    <div class="max-w-5xl mx-auto">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <span class="text-xs uppercase tracking-[0.25em] text-rosegold-500 font-semibold">Official Save The Date</span>
        <h2 class="font-serif text-3xl sm:text-5xl font-semibold text-sage-700 mt-1 mb-3">
          Our Video Invitation
        </h2>
        <p class="text-sm sm:text-base text-sage-600">
          Watch our interactive wedding invitation storyboard below, or attach your exported Canva MP4 video file directly into the player.
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
        <!-- Vertical 9:16 Phone Frame Player -->
        <div class="lg:col-span-5 flex justify-center">
          <div class="relative w-[300px] sm:w-[320px] h-[560px] rounded-[2.75rem] p-3 bg-gradient-to-b from-rosegold-300 via-rosegold-400 to-sage-600 shadow-2xl">
            <!-- Inner Phone Screen -->
            <div class="relative w-full h-full rounded-[2.15rem] bg-champagne overflow-hidden flex flex-col justify-between border border-white/60">

              <!-- Real HTML5 Video Element (Hidden until user selects/attaches MP4 or URL) -->
              <video
                id="attachedVideoPlayer"
                class="hidden absolute inset-0 w-full h-full object-cover z-20 bg-black"
                controls
                playsinline
              ></video>

              <!-- Interactive Animated Storyboard Preview (Default View) -->
              <div id="storyboardView" class="relative w-full h-full flex flex-col justify-between p-6 text-center bg-gradient-to-b from-sage-100/90 via-champagne to-rosegold-50/90 transition-all duration-500">
                <!-- Top Progress Bars (Instagram/Reels Style) -->
                <div class="flex gap-1.5 z-10">
                  <div class="h-1 flex-1 rounded-full bg-sage-200 overflow-hidden"><div id="prog-0" class="h-full bg-rosegold-500 w-full transition-all duration-300"></div></div>
                  <div class="h-1 flex-1 rounded-full bg-sage-200 overflow-hidden"><div id="prog-1" class="h-full bg-rosegold-500 w-0 transition-all duration-300"></div></div>
                  <div class="h-1 flex-1 rounded-full bg-sage-200 overflow-hidden"><div id="prog-2" class="h-full bg-rosegold-500 w-0 transition-all duration-300"></div></div>
                  <div class="h-1 flex-1 rounded-full bg-sage-200 overflow-hidden"><div id="prog-3" class="h-full bg-rosegold-500 w-0 transition-all duration-300"></div></div>
                  <div class="h-1 flex-1 rounded-full bg-sage-200 overflow-hidden"><div id="prog-4" class="h-full bg-rosegold-500 w-0 transition-all duration-300"></div></div>
                </div>

                <!-- Dynamic Slide Content -->
                <div id="slideContent" class="my-auto py-4 px-2 space-y-4 transition-opacity duration-300">
                  <!-- Populated via JS -->
                </div>

                <!-- Storyboard Controls -->
                <div class="z-10 space-y-3">
                  <div class="flex items-center justify-center gap-3">
                    <button
                      onclick="prevSlide()"
                      class="w-9 h-9 rounded-full bg-white/90 text-sage-700 hover:bg-rosegold-500 hover:text-white flex items-center justify-center shadow-sm transition-colors"
                      aria-label="Previous Slide"
                    >
                      &#8592;
                    </button>
                    <button
                      id="playPauseBtn"
                      onclick="toggleAutoplay()"
                      class="px-4 py-1.5 rounded-full text-xs font-semibold uppercase tracking-wider text-white rosegold-gradient shadow-sm"
                    >
                      Pause Story
                    </button>
                    <button
                      onclick="nextSlide()"
                      class="w-9 h-9 rounded-full bg-white/90 text-sage-700 hover:bg-rosegold-500 hover:text-white flex items-center justify-center shadow-sm transition-colors"
                      aria-label="Next Slide"
                    >
                      &#8594;
                    </button>
                  </div>
                  <p class="text-[10px] uppercase tracking-widest text-sage-500">
                    Interactive Invitation Preview
                  </p>
                </div>
              </div>

              <!-- Switch Back to Storyboard Button when MP4 is active -->
              <button
                id="backToStoryboardBtn"
                onclick="unloadCustomVideo()"
                class="hidden absolute top-3 right-3 z-30 px-2.5 py-1 rounded-full bg-black/65 text-white text-[10px] uppercase tracking-wider hover:bg-rosegold-600 transition-colors"
              >
                Show Preview
              </button>
            </div>
          </div>
        </div>

        <!-- Right Column: Chapter Navigation & Attach Video File Controls -->
        <div class="lg:col-span-7 space-y-6">
          <div class="rounded-3xl bg-white p-6 sm:p-8 rosegold-border shadow-soft space-y-5">
            <div class="flex items-start justify-between gap-4">
              <div>
                <h3 class="font-serif text-2xl font-semibold text-sage-700">Attach Your MP4 Video File</h3>
                <p class="text-sm text-sage-600 mt-1">
                  Have your Canva video file (<code class="text-xs bg-sage-100 px-1.5 py-0.5 rounded text-sage-800">video_1.mp4</code>) on your phone or laptop? Load it directly into the frame to play it with sound, or paste a Canva/YouTube share link.
                </p>
              </div>
              <span class="shrink-0 w-10 h-10 rounded-2xl bg-rosegold-50 text-rosegold-500 flex items-center justify-center">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"/>
                </svg>
              </span>
            </div>

            <!-- File Upload Input -->
            <div class="flex flex-col sm:flex-row gap-3">
              <label class="flex-1 cursor-pointer flex items-center justify-center gap-2 px-5 py-3 rounded-xl rosegold-gradient text-white text-sm font-medium shadow-rosegold hover:opacity-95 transition-all">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/>
                </svg>
                <span>Select Video File (.MP4 / .MOV)</span>
                <input type="file" id="videoFileInput" accept="video/*" class="hidden" onchange="handleVideoUpload(event)" />
              </label>
            </div>

            <!-- Optional Direct Video URL Input -->
            <div class="pt-2 border-t border-sage-100">
              <label for="videoUrlInput" class="block text-xs uppercase tracking-wider text-sage-500 font-semibold mb-1.5">
                Or Paste Direct MP4 / Video Link
              </label>
              <div class="flex gap-2">
                <input
                  type="url"
                  id="videoUrlInput"
                  placeholder="https://example.com/kaye-val-invitation.mp4"
                  class="flex-1 px-3.5 py-2 rounded-xl border border-sage-200 text-sm focus:outline-none focus:border-rosegold-400"
                />
                <button
                  onclick="loadVideoFromUrl()"
                  class="px-4 py-2 rounded-xl bg-sage-600 text-white text-xs font-semibold uppercase tracking-wider hover:bg-sage-700 transition-colors"
                >
                  Load
                </button>
              </div>
            </div>
          </div>

          <!-- Interactive Chapters matching the Video -->
          <div class="rounded-3xl bg-white p-6 sm:p-8 rosegold-border shadow-soft">
            <h4 class="text-xs uppercase tracking-[0.2em] text-rosegold-500 font-semibold mb-4">
              Jump to Invitation Chapter
            </h4>
            <div class="grid grid-cols-2 sm:grid-cols-3 gap-2.5">
              <button onclick="goToSlide(0)" class="chapter-btn text-left p-3 rounded-xl border border-sage-200 hover:border-rosegold-400 hover:bg-rosegold-50/50 transition-all">
                <span class="block text-[10px] uppercase tracking-wider text-rosegold-500 font-semibold">01 • Intro</span>
                <span class="font-serif text-base font-semibold text-sage-700">Save The Date</span>
              </button>
              <button onclick="goToSlide(1)" class="chapter-btn text-left p-3 rounded-xl border border-sage-200 hover:border-rosegold-400 hover:bg-rosegold-50/50 transition-all">
                <span class="block text-[10px] uppercase tracking-wider text-rosegold-500 font-semibold">02 • Venues</span>
                <span class="font-serif text-base font-semibold text-sage-700">When &amp; Where</span>
              </button>
              <button onclick="goToSlide(2)" class="chapter-btn text-left p-3 rounded-xl border border-sage-200 hover:border-rosegold-400 hover:bg-rosegold-50/50 transition-all">
                <span class="block text-[10px] uppercase tracking-wider text-rosegold-500 font-semibold">03 • Honor</span>
                <span class="font-serif text-base font-semibold text-sage-700">Entourage</span>
              </button>
              <button onclick="goToSlide(3)" class="chapter-btn text-left p-3 rounded-xl border border-sage-200 hover:border-rosegold-400 hover:bg-rosegold-50/50 transition-all">
                <span class="block text-[10px] uppercase tracking-wider text-rosegold-500 font-semibold">04 • Style</span>
                <span class="font-serif text-base font-semibold text-sage-700">Attire &amp; RSVP</span>
              </button>
              <button onclick="goToSlide(4)" class="chapter-btn text-left p-3 rounded-xl border border-sage-200 hover:border-rosegold-400 hover:bg-rosegold-50/50 transition-all col-span-2 sm:col-span-2">
                <span class="block text-[10px] uppercase tracking-wider text-rosegold-500 font-semibold">05 • Blessings</span>
                <span class="font-serif text-base font-semibold text-sage-700">Gift Guide &amp; InstaPay</span>
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. CEREMONY & RECEPTION DETAILS -->
  <section id="details" class="py-16 sm:py-24 px-4 sm:px-6 reveal">
