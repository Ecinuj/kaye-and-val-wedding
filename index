      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        <!-- RSVP Form -->
        <div class="lg:col-span-7 rounded-3xl bg-white p-6 sm:p-9 rosegold-border shadow-soft">
          <form id="rsvpForm" onsubmit="submitRsvp(event)" class="space-y-5">
            <div>
              <label for="guestName" class="block text-xs uppercase tracking-wider font-semibold text-sage-700 mb-1.5">
                Primary Guest Full Name *
              </label>
              <input
                type="text"
                id="guestName"
                required
                placeholder="e.g., Juan Dela Cruz"
                class="w-full px-4 py-3 rounded-xl border border-sage-200 text-sm focus:outline-none focus:border-rosegold-400 bg-champagne/40"
              />
            </div>

            <!-- Attendance Selection -->
            <div>
              <label class="block text-xs uppercase tracking-wider font-semibold text-sage-700 mb-1.5">
                Will you attend? *
              </label>
              <div class="grid grid-cols-2 gap-3">
                <label class="cursor-pointer">
                  <input type="radio" name="attending" value="Yes" checked onchange="toggleSeatFields(true)" class="peer sr-only" />
                  <div class="p-3 rounded-xl border border-sage-200 text-center text-sm font-medium text-sage-700 peer-checked:bg-sage-600 peer-checked:text-white peer-checked:border-sage-600 transition-all">
