  <script>
    // ==========================================
    // 1. LIVE COUNTDOWN TIMER (Dec 09, 2026 2:00 PM PHT)
    // ==========================================
    const weddingDate = new Date('2026-12-09T14:00:00+08:00').getTime();

    function updateCountdown() {
      const now = new Date().getTime();
      const diff = weddingDate - now;

      if (diff <= 0) {
        document.getElementById('cd-days').textContent = '00';
        document.getElementById('cd-hours').textContent = '00';
        document.getElementById('cd-mins').textContent = '00';
        document.getElementById('cd-secs').textContent = '00';
        return;
      }

      const days = Math.floor(diff / (1000 * 60 * 60 * 24));
      const hours = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
      const mins = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
      const secs = Math.floor((diff % (1000 * 60)) / 1000);

      document.getElementById('cd-days').textContent = String(days).padStart(2, '0');
      document.getElementById('cd-hours').textContent = String(hours).padStart(2, '0');
      document.getElementById('cd-mins').textContent = String(mins).padStart(2, '0');
      document.getElementById('cd-secs').textContent = String(secs).padStart(2, '0');
    }
    setInterval(updateCountdown, 1000);
    updateCountdown();

    // ==========================================
    // 2. INTERACTIVE VIDEO INVITATION STORYBOARD & PLAYER
    // ==========================================
    const slides = [
      {
        tag: 'Save The Date',
        script: 'We are getting married...',
        title: 'Kaye & Val',
        subtitle: 'EMILY CLAIRE B. BARANUELO\n&\nVAL CELSO P. CUNANAN JR.',
        footer: 'Request the honor of your presence'
      },
      {
        tag: 'December 09, 2026',
        script: 'Wednesday at 2:00 PM',
        title: 'Basilica of Our Lady of Peñafrancia',
        subtitle: 'Naga City, Camarines Sur',
        footer: 'Reception to follow at Queen Rose Hall, Robertson Hotel'
      },
      {
        tag: 'The Entourage',
        script: 'With Our Loving Families',
        title: 'Parents & Sponsors',
        subtitle: 'Bestman: Christian John P. Cunanan\nMaid of Honor: Bendra C. Bañaga\nMatron of Honor: Florence Claire B. Ragos',
        footer: 'Surrounded by Principal & Secondary Sponsors'
      },
      {
        tag: 'Attire & RSVP',
        script: 'Semi-Formal Elegance',
        title: 'Will You Join Us?',
        subtitle: 'Natural sage, misty teal, champagne & blush rose tones.',
        footer: 'Kindly RSVP on or before December 1, 2026'
      },
      {
        tag: 'Gift Guide',
        script: 'Your presence is our greatest gift',
        title: 'Monetary Blessings',
        subtitle: 'InstaPay QR available below for those who wish to bless our new chapter.',
        footer: 'Thank you for sharing our special day!'
      }
    ];

    let currentSlide = 0;
    let autoplayTimer = null;
    let isPlaying = true;

    function renderSlide(index) {
      currentSlide = (index + slides.length) % slides.length;
      const slide = slides[currentSlide];
      const container = document.getElementById('slideContent');

      container.innerHTML = `
        <span class="inline-block px-3 py-1 rounded-full bg-rosegold-100 text-rosegold-600 text-[10px] font-semibold uppercase tracking-[0.2em]">
          ${slide.tag}
        </span>
        <p class="font-script text-3xl text-rosegold-500 pt-1">${slide.script}</p>
        <h4 class="font-serif text-2xl font-bold text-sage-800 leading-tight">${slide.title}</h4>
        <p class="text-xs text-sage-700 whitespace-pre-line leading-relaxed font-medium px-2">${slide.subtitle}</p>
        <div class="pt-2">
          <span class="inline-block h-px w-10 bg-rosegold-300 mb-2"></span>
          <p class="text-[11px] italic font-serif text-sage-600">${slide.footer}</p>
        </div>
      `;

      // Update progress bars
      for (let i = 0; i < slides.length; i++) {
        const bar = document.getElementById(`prog-${i}`);
        if (bar) {
          bar.style.width = i <= currentSlide ? '100%' : '0%';
        }
      }
    }

    function nextSlide() {
      renderSlide(currentSlide + 1);
    }

    function prevSlide() {
      renderSlide(currentSlide - 1);
    }

    function goToSlide(idx) {
      unloadCustomVideo();
      renderSlide(idx);
    }

    function startAutoplay() {
      stopAutoplay();
      autoplayTimer = setInterval(nextSlide, 4200);
      isPlaying = true;
      document.getElementById('playPauseBtn').textContent = 'Pause Story';
    }

    function stopAutoplay() {
      if (autoplayTimer) clearInterval(autoplayTimer);
      isPlaying = false;
      document.getElementById('playPauseBtn').textContent = 'Play Story';
    }

    function toggleAutoplay() {
      if (isPlaying) stopAutoplay();
      else startAutoplay();
    }

    // Handle local MP4 file upload
    function handleVideoUpload(event) {
      const file = event.target.files[0];
      if (!file) return;
      const url = URL.createObjectURL(file);
      activateVideoPlayer(url);
      showToast('Video invitation attached!');
    }

    function loadVideoFromUrl() {
      const url = document.getElementById('videoUrlInput').value.trim();
      if (!url) {
        showToast('Please paste a valid MP4 video link first.');
        return;
      }
      activateVideoPlayer(url);
      showToast('Video URL loaded!');
    }

    function activateVideoPlayer(src) {
      stopAutoplay();
      const videoEl = document.getElementById('attachedVideoPlayer');
      const storyboardEl = document.getElementById('storyboardView');
      const backBtn = document.getElementById('backToStoryboardBtn');

      videoEl.src = src;
      videoEl.classList.remove('hidden');
      storyboardEl.classList.add('hidden');
      backBtn.classList.remove('hidden');
      videoEl.play().catch(() => {});
    }

    function unloadCustomVideo() {
      const videoEl = document.getElementById('attachedVideoPlayer');
      const storyboardEl = document.getElementById('storyboardView');
      const backBtn = document.getElementById('backToStoryboardBtn');

      videoEl.pause();
      videoEl.classList.add('hidden');
      storyboardEl.classList.remove('hidden');
      backBtn.classList.add('hidden');
      startAutoplay();
    }

    renderSlide(0);
    startAutoplay();

    // ==========================================
    // 3. ENTOURAGE FILTER TABS
    // ==========================================
    function filterEntourage(category) {
      document.querySelectorAll('.entourage-tab').forEach(btn => {
        if (btn.dataset.tab === category) {
          btn.classList.add('bg-sage-600', 'text-white');
          btn.classList.remove('bg-white', 'text-sage-700');
        } else {
          btn.classList.remove('bg-sage-600', 'text-white');
          btn.classList.add('bg-white', 'text-sage-700');
        }
      });

      document.querySelectorAll('.entourage-group').forEach(group => {
        if (category === 'all' || group.dataset.group === category) {
          group.classList.remove('hidden');
        } else {
          group.classList.add('hidden');
        }
      });
    }

    // ==========================================
    // 4. RSVP & SEAT RESERVATION SYSTEM
    // ==========================================
    const STORAGE_KEY = 'kaye_val_wedding_rsvps_v1';
    let lastSubmittedMessage = '';

    function toggleSeatFields(isAttending) {
      const wrapper = document.getElementById('seatReservationWrapper');
      if (isAttending) {
        wrapper.classList.remove('hidden');
      } else {
        wrapper.classList.add('hidden');
      }
    }

    function renderAdditionalGuests() {
      const count = parseInt(document.getElementById('seatCount').value, 10);
      const container = document.getElementById('additionalGuestsContainer');
      container.innerHTML = '';

      for (let i = 2; i <= count; i++) {
        const div = document.createElement('div');
        div.innerHTML = `
          <input
            type="text"
            class="extra-guest-input w-full px-4 py-2.5 rounded-xl border border-sage-200 text-sm focus:outline-none focus:border-rosegold-400 bg-white"
            placeholder="Companion Guest #${i} Full Name"
          />
        `;
        container.appendChild(div);
      }
    }

    function getSavedRsvps() {
      try {
        const raw = localStorage.getItem(STORAGE_KEY);
        if (raw) return JSON.parse(raw);
      } catch (e) {}
      return [
        {
          id: 1,
          name: 'Cunanan & Baranuelo Family',
          attending: 'Yes',
          seats: 4,
          companions: ['Alma P. Cunanan', 'Romualdo P. Baranuelo', 'Emily B. Baranuelo'],
          message: 'Excited for December 9!'
        }
      ];
    }

    function saveRsvps(list) {
      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(list));
      } catch (e) {}
      renderGuestDashboard();
    }

    function submitRsvp(event) {
      event.preventDefault();
      const name = document.getElementById('guestName').value.trim();
      const attending = document.querySelector('input[name="attending"]:checked').value;
      const seats = attending === 'Yes' ? parseInt(document.getElementById('seatCount').value, 10) : 0;
      const companions = Array.from(document.querySelectorAll('.extra-guest-input'))
        .map(inp => inp.value.trim())
        .filter(Boolean);
      const message = document.getElementById('guestMessage').value.trim();

      const list = getSavedRsvps();
      list.unshift({
        id: Date.now(),
        name,
        attending,
        seats,
        companions,
        message
      });
      saveRsvps(list);

      // Prepare Messenger text
      if (attending === 'Yes') {
        const compText = companions.length ? ` (with ${companions.join(', ')})` : '';
        lastSubmittedMessage = `Hi Kaye & Val! RSVP Confirmation:\nName: ${name}${compText}\nAttending: YES\nSeats Reserved: ${seats}\nMessage: ${message || 'Congratulations!'}`;
        document.getElementById('rsvpSummaryText').textContent =
          `We have reserved ${seats} seat(s) for ${name}${compText}.`;
      } else {
        lastSubmittedMessage = `Hi Kaye & Val! RSVP Response:\nName: ${name}\nAttending: Regretfully Declines\nMessage: ${message || 'Sending warm wishes!'}`;
        document.getElementById('rsvpSummaryText').textContent =
          `Thank you for letting us know, ${name}. You will be missed!`;
      }

      document.getElementById('rsvpSuccessBox').classList.remove('hidden');
      document.getElementById('rsvpForm').reset();
      toggleSeatFields(true);
      renderAdditionalGuests();
      showToast('Seat reservation saved!');
    }

    function renderGuestDashboard() {
      const list = getSavedRsvps();
      const container = document.getElementById('guestListContainer');
      const totalSeats = list.reduce((sum, item) => sum + (item.attending === 'Yes' ? item.seats : 0), 0);

      document.getElementById('totalSeatsBadge').textContent = totalSeats;

      if (list.length === 0) {
        container.innerHTML = '<p class="text-xs text-sage-400 text-center py-6">No RSVPs recorded yet.</p>';
        return;
      }

      container.innerHTML = list.map(item => `
        <div class="p-3 rounded-2xl bg-sage-50/80 border border-sage-200/70 flex items-start justify-between gap-3">
          <div>
            <p class="font-serif text-base font-semibold text-sage-800">${item.name}</p>
            ${item.companions && item.companions.length ? `<p class="text-[11px] text-sage-500">+ ${item.companions.join(', ')}</p>` : ''}
            ${item.message ? `<p class="text-xs italic text-sage-600 mt-1">"${item.message}"</p>` : ''}
          </div>
          <span class="shrink-0 px-2.5 py-1 rounded-full text-[10px] font-semibold uppercase tracking-wider ${
            item.attending === 'Yes'
              ? 'bg-sage-600 text-white'
              : 'bg-rosegold-100 text-rosegold-600'
          }">
            ${item.attending === 'Yes' ? `${item.seats} Seat${item.seats > 1 ? 's' : ''}` : 'Declined'}
          </span>
        </div>
      `).join('');
    }

    function copyMessengerRsvp() {
      if (!lastSubmittedMessage) return;
      copyTextToClipboard(lastSubmittedMessage);
      showToast('RSVP copied! Paste it in Facebook Messenger.');
    }

    function exportRsvpCsv() {
      const list = getSavedRsvps();
      const rows = [['Primary Guest', 'Attending', 'Reserved Seats', 'Additional Guests', 'Message']];
      list.forEach(r => {
        rows.push([
          `"${r.name.replace(/"/g, '""')}"`,
          r.attending,
          r.seats,
          `"${(r.companions || []).join('; ').replace(/"/g, '""')}"`,
          `"${(r.message || '').replace(/"/g, '""')}"`
        ]);
      });
      const csvContent = 'data:text/csv;charset=utf-8,' + rows.map(e => e.join(',')).join('\n');
      const link = document.createElement('a');
      link.setAttribute('href', encodeURI(csvContent));
      link.setAttribute('download', 'Kaye_and_Val_RSVP_Seats.csv');
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
      showToast('CSV Guest List downloaded!');
    }

    function clearRsvpData() {
      localStorage.removeItem(STORAGE_KEY);
      renderGuestDashboard();
      showToast('Demo RSVP list reset.');
    }

    renderAdditionalGuests();
    renderGuestDashboard();

    // ==========================================
    // 5. QR UPLOAD, CANVA MODAL & UTILITIES
    // ==========================================
    function handleQrUpload(event) {
      const file = event.target.files[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = function (e) {
        const img = document.getElementById('qrPreviewImg');
        img.src = e.target.result;
        img.classList.remove('hidden');
        document.getElementById('qrPlaceholder').classList.add('hidden');
        showToast('InstaPay QR code attached!');
      };
      reader.readAsDataURL(file);
    }

    function toggleCanvaModal(show) {
      const modal = document.getElementById('canvaModal');
      if (show) modal.classList.remove('hidden');
      else modal.classList.add('hidden');
    }

    function copyHex(hex) {
      copyTextToClipboard(hex);
      showToast(`Copied ${hex} for Canva!`);
    }

    function copyTextToClipboard(text) {
      const textarea = document.createElement('textarea');
      textarea.value = text;
      document.body.appendChild(textarea);
      textarea.select();
      document.execCommand('copy');
      document.body.removeChild(textarea);
    }

    function showToast(msg) {
      const toast = document.getElementById('toast');
      toast.textContent = msg;
      toast.classList.remove('opacity-0');
      setTimeout(() => {
        toast.classList.add('opacity-0');
      }, 2800);
    }

    // Scroll reveal observer
    const observer = new IntersectionObserver(
      entries => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
          }
        });
      },
      { threshold: 0.1 }
    );
    document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
  </script>
</body>
</html>
